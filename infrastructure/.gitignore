# Terraform state files — never commit these, they contain sensitive data
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup

# Variable files — may contain secrets like DB passwords
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json